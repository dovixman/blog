---
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { person, stations, experience, education, navItems } from '../data/content.js';

const title = 'David Fuentes (dovixman) — Lead Technical Architect';
const description =
  'David Fuentes, dovixman: Tech Lead y Software Architect. Lead Technical Architect en Intelygenz (MetTel). Arquitectura de software, liderazgo de equipos, inteligencia artificial, ciberseguridad y laboratorios de blockchain.';
const canonical = new URL('/', Astro.site).href;
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#05060d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    <!-- Google Analytics (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-461656PKYM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-461656PKYM');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <!-- Static, CSS-only universe: always present underneath, visible without WebGL / with reduced motion -->
    <div class="sky" aria-hidden="true"></div>
    <!-- WebGL canvas gets mounted here when available -->
    <div id="universe" class="universe" aria-hidden="true"></div>

    <header class="topbar">
      <a class="brand" href="#inicio" aria-label="dovixman, volver al inicio">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="16" r="6" fill="currentColor"></circle>
          <ellipse cx="16" cy="16" rx="14" ry="5" fill="none" stroke="currentColor" stroke-width="1.5" transform="rotate(-24 16 16)"></ellipse>
        </svg>
        <span>dovixman</span>
      </a>

      <div class="topbar-actions">
        <button class="mode-toggle" type="button" id="mode-toggle" aria-pressed="false" hidden>
          <span class="mode-dot" aria-hidden="true"></span>
          <span class="mode-label">Universo 3D</span>
        </button>

        <details class="menu" id="menu">
          <summary>
            <span>Índice</span>
            <span class="menu-icon" aria-hidden="true"></span>
          </summary>
          <nav class="menu-panel" aria-label="Índice de secciones">
            <ol>
              {
                navItems.map((item) => (
                  <li>
                    <a href={`#${item.id}`}>
                      <span class="menu-index">{item.index}</span>
                      <span>{item.label}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </details>
      </div>
    </header>

    <nav class="rail" aria-label="Estaciones">
      <ol>
        {
          navItems.map((item) => (
            <li>
              <a href={`#${item.id}`} data-rail={item.id}>
                <span class="rail-label">{item.label}</span>
                <span class="rail-dot" aria-hidden="true" />
                <span class="visually-hidden">Estación {item.index}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <main id="contenido">
      <!-- 00 · Núcleo -->
      <section class="station station--hero" id="inicio" data-station="0" aria-labelledby="hero-title" style="--accent:#ffcf8a">
        <div class="orb orb--sun" aria-hidden="true"></div>
        <div class="panel panel--hero">
          <p class="eyebrow"><span class="eyebrow-index">00</span> Núcleo · {person.handle}</p>
          <h1 id="hero-title" class="hero-title">
            <span class="line">David</span>
            <span class="line">Fuentes</span>
          </h1>
          <p class="hero-role">
            {person.role} en <strong>{person.company}</strong> <span class="muted">— proyecto {person.project}</span>
          </p>
          <p class="lead">
            Tech Lead y Software Architect. Desde 2012 construyendo software: de desarrollador Java a liderar la
            arquitectura técnica en proyectos para Inditex y MetTel, con la inteligencia artificial y la ciberseguridad como
            órbitas propias.
          </p>
          <div class="cta-row">
            <a class="btn btn--primary" href="#arquitectura">Iniciar el viaje <span aria-hidden="true">↓</span></a>
            <a class="btn btn--ghost" href={`mailto:${person.email}`}>{person.email}</a>
          </div>
          <p class="hint" aria-hidden="true">
            <span class="hint-mouse"></span>
            Desplázate para viajar entre estaciones · o salta con el Índice
          </p>
        </div>
      </section>

      {
        stations.map((s, i) => (
          <section
            class={`station station--${s.id}`}
            id={s.id}
            data-station={i + 1}
            aria-labelledby={`${s.id}-title`}
            style={`--accent:${s.accent}`}
          >
            <div class={`orb orb--${s.id}`} aria-hidden="true" />
            <div class="panel">
              <p class="eyebrow">
                <span class="eyebrow-index">{s.index}</span> {s.kicker}
              </p>
              <h2 id={`${s.id}-title`} class="station-title">
                {s.title}
              </h2>
              {s.body.map((p) => (
                <p>{p}</p>
              ))}
              {s.facts.length > 0 && (
                <ul class="facts" aria-label="Relacionado">
                  {s.facts.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              )}
              {s.link && (
                <a class="text-link" href={s.link.href} rel="me noopener">
                  {s.link.text} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </section>
        ))
      }

      <!-- 06 · Trayectoria -->
      <section class="station station--trayectoria" id="trayectoria" data-station="6" aria-labelledby="trayectoria-title" style="--accent:#cfd8ff">
        <div class="panel panel--wide">
          <p class="eyebrow"><span class="eyebrow-index">06</span> Vista orbital</p>
          <h2 id="trayectoria-title" class="station-title">Trayectoria</h2>
          <p>Todas las órbitas a la vez: el recorrido completo, de la primera línea de Java a la arquitectura técnica.</p>

          <div class="timeline-grid">
            <div>
              <h3 class="timeline-heading">Experiencia</h3>
              <ol class="timeline">
                {
                  experience.map((e) => (
                    <li class:list={['timeline-item', { 'is-current': e.current }]}>
                      <span class="timeline-period">{e.period}</span>
                      <span class="timeline-role">{e.role}</span>
                      <span class="timeline-org">
                        {e.org}
                        {e.detail && <> · {e.detail}</>}
                      </span>
                    </li>
                  ))
                }
              </ol>
            </div>
            <div>
              <h3 class="timeline-heading">Formación</h3>
              <ol class="timeline">
                {
                  education.map((e) => (
                    <li class="timeline-item">
                      <span class="timeline-period">{e.period}</span>
                      <span class="timeline-role">{e.title}</span>
                      {e.detail && <span class="timeline-org">{e.detail}</span>}
                    </li>
                  ))
                }
              </ol>
            </div>
          </div>
        </div>
      </section>

      <!-- 07 · Contacto -->
      <section class="station station--contacto" id="contacto" data-station="7" aria-labelledby="contacto-title" style="--accent:#ffcf8a">
        <div class="panel panel--contact">
          <p class="eyebrow"><span class="eyebrow-index">07</span> Señal de salida</p>
          <h2 id="contacto-title" class="station-title station-title--xl">¿Hablamos?</h2>
          <p class="lead">
            Arquitectura, liderazgo técnico, inteligencia artificial o seguridad: si quieres conversar sobre
            cualquiera de estas órbitas, abre un canal.
          </p>
          <ul class="contact-list">
            <li>
              <a class="contact-link" href={`mailto:${person.email}`}>
                <span class="contact-kind">Email</span>
                <span class="contact-value">{person.email}</span>
                <span class="contact-arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a class="contact-link" href={person.github} rel="me noopener">
                <span class="contact-kind">GitHub</span>
                <span class="contact-value">github.com/dovixman</span>
                <span class="contact-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>© {new Date().getFullYear()} David Fuentes · dovixman.io</p>
      <p class="muted">Universo generado en tiempo real con Three.js y shaders propios. Sin modelos, sin texturas.</p>
    </footer>

    <!-- 3D tooltip + HUD (decorative; everything is reachable through the HTML above) -->
    <div class="tooltip" id="tooltip" aria-hidden="true"></div>
    <div class="hud" id="hud" aria-hidden="true">
      <span class="hud-station" id="hud-station">00 · Núcleo</span>
      <span class="hud-coords" id="hud-coords"></span>
    </div>

    <script>
      import { boot } from '../scripts/boot.js';
      boot();
    </script>
  </body>
</html>
