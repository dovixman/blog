---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostMeta from '../components/PostMeta.astro';
import TagList from '../components/TagList.astro';
import { getPosts, url } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    {post.data.updated && <meta property="article:modified_time" content={post.data.updated.toISOString()} />}
    <meta property="article:section" content={post.data.category} />
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {post.data.draft && <meta name="robots" content="noindex" />}
  </Fragment>
  <article>
    <header class="post-header">
      <PostMeta post={post} />
      <h1 class="page-title">{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <TagList tags={post.data.tags} />
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-footer">
      <nav class="pager" aria-label="Más artículos">
        {older ? <a href={url(`${older.id}/`)}>← {older.data.title}</a> : <span />}
        {newer && <a href={url(`${newer.id}/`)}>{newer.data.title} →</a>}
      </nav>
    </footer>
  </article>
</Base>
