---
/**
 * Hand-drawn SVG strokes. Every path uses pathLength="1" so the ink script can
 * "draw" it by animating stroke-dashoffset from 1 to 0 as the reader scrolls.
 */
interface Props {
  kind:
    | 'underline'
    | 'underline-short'
    | 'squiggle'
    | 'circle'
    | 'arrow-left'
    | 'arrow-down'
    | 'arrow-up'
    | 'arrow-back'
    | 'vline'
    | 'clip';
  class?: string;
  color?: 'ink' | 'red' | 'pencil';
}

const { kind, class: className = '', color = 'ink' } = Astro.props;

const shapes: Record<Props['kind'], { viewBox: string; stretch?: boolean; width?: number; paths: string[] }> = {
  underline: {
    viewBox: '0 0 300 24',
    stretch: true,
    width: 3,
    paths: ['M4 14 C 52 7, 112 5, 162 9 S 252 15, 296 7', 'M26 19 C 96 14, 186 13, 274 14'],
  },
  'underline-short': {
    viewBox: '0 0 300 24',
    stretch: true,
    width: 3,
    paths: ['M5 15 C 60 9, 130 8, 190 11 C 230 13, 270 12, 295 8'],
  },
  squiggle: {
    viewBox: '0 0 120 16',
    stretch: true,
    width: 2.2,
    paths: ['M3 9 q 7 -10 14 0 t 14 0 t 14 0 t 14 0 t 14 0 t 14 0 t 14 0 t 14 0'],
  },
  circle: {
    viewBox: '0 0 400 120',
    stretch: true,
    width: 2.6,
    paths: ['M226 9 C 130 2, 22 18, 12 58 C 3 98, 136 116, 232 111 C 334 106, 394 84, 388 52 C 382 18, 292 4, 168 15'],
  },
  'arrow-left': {
    viewBox: '0 0 170 120',
    width: 2.6,
    paths: ['M160 18 C 128 8, 96 18, 82 44 C 68 70, 52 92, 14 98', 'M34 84 L 13 98 L 36 110'],
  },
  'arrow-down': {
    viewBox: '0 0 120 170',
    width: 2.8,
    paths: ['M18 8 C 70 14, 104 46, 88 86 C 76 116, 62 134, 64 158', 'M48 140 L 64 160 L 80 138'],
  },
  'arrow-up': {
    viewBox: '0 0 90 90',
    width: 2.4,
    paths: ['M70 82 C 44 76, 24 58, 22 14', 'M10 30 L 22 12 L 36 28'],
  },
  'arrow-back': {
    viewBox: '0 0 110 60',
    width: 2.4,
    paths: ['M104 38 C 80 50, 46 50, 14 22', 'M14 44 L 12 20 L 36 18'],
  },
  vline: {
    viewBox: '0 0 20 1000',
    stretch: true,
    width: 2.2,
    paths: ['M10 0 C 4 120, 16 240, 9 360 S 4 600, 11 720 S 15 900, 9 1000'],
  },
  clip: {
    viewBox: '0 0 44 120',
    width: 3,
    paths: ['M30 34 V 96 a 12 12 0 0 1 -24 0 V 16 a 9 9 0 0 1 18 0 V 88 a 4 4 0 0 1 -8 0 V 34'],
  },
};

const shape = shapes[kind];
---

<svg
  class={`doodle doodle--${kind} doodle--${color} ${className}`}
  viewBox={shape.viewBox}
  preserveAspectRatio={shape.stretch ? 'none' : 'xMidYMid meet'}
  aria-hidden="true"
  focusable="false"
  data-draw
>
  {
    shape.paths.map((d) => (
      <path
        d={d}
        pathLength="1"
        fill="none"
        stroke="currentColor"
        stroke-width={shape.width ?? 2.5}
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ))
  }
</svg>
