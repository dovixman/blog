---
import { domains } from '../data/profile';

const C = 300;
const R = 222;
const nodes = domains.map((d, i) => {
  const a = ((-90 + i * 60) * Math.PI) / 180;
  const x = C + Math.cos(a) * R;
  const y = C + Math.sin(a) * R;
  // Hub port on a 64px ring, then a soft elbow to the node.
  const px = C + Math.cos(a) * 64;
  const py = C + Math.sin(a) * 64;
  const mx = C + Math.cos(a) * 150;
  const my = C + Math.sin(a) * 150;
  const bend = ((i % 2 ? 1 : -1) * 26 * Math.PI) / 180;
  const cx = C + Math.cos(a + bend) * 120;
  const cy = C + Math.sin(a + bend) * 120;
  const ex = C + Math.cos(a) * (R - 34);
  const ey = C + Math.sin(a) * (R - 34);
  const path = `M${px.toFixed(1)} ${py.toFixed(1)} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${mx.toFixed(1)} ${my.toFixed(1)} L${ex.toFixed(1)} ${ey.toFixed(1)}`;
  return { ...d, x, y, path };
});
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
---

<section class="section system" id="sistema" aria-labelledby="sistema-title">
  <div class="wrap">
    <header class="section-head">
      <p class="section-index mono" data-reveal>01 · Sistema</p>
      <div>
        <h2 class="section-title" id="sistema-title" data-split>Un sistema, <span class="muted">seis dominios.</span></h2>
        <p class="section-lede" data-reveal>
          Mi trabajo se organiza como cualquier buena arquitectura: un núcleo con criterio y servicios bien
          delimitados que se hablan entre sí. Estos son los dominios en los que opero.
        </p>
      </div>
    </header>

    <div class="system-grid">
      <figure class="diagram-wrap" data-diagram>
        <svg class="diagram" viewBox="0 0 600 600" role="img" aria-labelledby="diagram-title">
          <title id="diagram-title">Diagrama: un núcleo central conectado con seis dominios numerados del 01 al 06</title>
          <defs>
            <radialGradient id="hubGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#7cf0c5" stop-opacity="0.28"></stop>
              <stop offset="100%" stop-color="#7cf0c5" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <g class="d-rings" aria-hidden="true">
            <circle cx={C} cy={C} r="150" class="ring"></circle>
            <circle cx={C} cy={C} r={R} class="ring ring--dash" data-orbit></circle>
            <circle cx={C} cy={C} r="286" class="ring ring--faint"></circle>
            <g class="ticks" data-ticks>
              {
                ticks.map((t) => (
                  <line
                    x1={C}
                    y1={C - 286}
                    x2={C}
                    y2={C - (t % 30 === 0 ? 274 : 280)}
                    transform={`rotate(${t} ${C} ${C})`}
                  />
                ))
              }
            </g>
          </g>
          <g class="d-edges" aria-hidden="true">
            {nodes.map((n) => <path d={n.path} class="edge" data-edge={n.key} />)}
            {nodes.map((n) => <path d={n.path} class="edge-flow" data-flow={n.key} />)}
            {nodes.map((n) => <circle r="3" class="packet" data-packet={n.key} cx="-10" cy="-10" />)}
          </g>
          <g class="d-hub" aria-hidden="true">
            <circle cx={C} cy={C} r="120" fill="url(#hubGlow)"></circle>
            <circle cx={C} cy={C} r="64" class="hub"></circle>
            <circle cx={C} cy={C} r="52" class="hub-inner" data-hub-spin></circle>
            <text x={C} y={C - 4} class="hub-label">DF</text>
            <text x={C} y={C + 18} class="hub-sub">core</text>
          </g>
          <g class="d-nodes" aria-hidden="true">
            {
              nodes.map((n) => (
                <g class="node" data-node={n.key} transform={`translate(${n.x.toFixed(1)} ${n.y.toFixed(1)})`}>
                  <rect x="-34" y="-34" width="68" height="68" rx="14" class="node-box" />
                  <text y="2" class="node-n">
                    {n.n}
                  </text>
                  <text y="20" class="node-k">
                    {n.tag}
                  </text>
                </g>
              ))
            }
          </g>
        </svg>
        <figcaption class="mono diagram-cap">
          <span>topología · núcleo + 6 servicios</span>
          <span data-active-label>activo: —</span>
        </figcaption>
      </figure>

      <ol class="domains">
        {
          domains.map((d) => (
            <li class="domain" data-domain={d.key} tabindex="0">
              <div class="domain-head">
                <span class="domain-n mono">{d.n}</span>
                <span class="domain-id mono" aria-hidden="true">svc.{d.tag}</span>
              </div>
              <h3 class="domain-title">{d.title}</h3>
              <p class="domain-body">{d.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .system-grid {
    display: grid;
    gap: 48px;
  }

  @media (min-width: 1000px) {
    .system-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 72px;
      align-items: start;
    }
    .diagram-wrap {
      position: sticky;
      top: 110px;
    }
  }

  .diagram-wrap {
    margin: 0;
  }

  .diagram {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  .ring {
    fill: none;
    stroke: var(--line-2);
    stroke-width: 1;
  }

  .ring--dash {
    stroke-dasharray: 2 6;
    stroke: rgba(124, 240, 197, 0.35);
  }

  .ring--faint {
    stroke: var(--line);
  }

  .ticks line {
    stroke: rgba(196, 214, 230, 0.22);
    stroke-width: 1;
  }

  .edge {
    fill: none;
    stroke: rgba(196, 214, 230, 0.22);
    stroke-width: 1.2;
    transition: stroke 0.4s var(--ease);
  }

  .edge-flow {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.4;
    stroke-dasharray: 4 14;
    opacity: 0.35;
    transition: opacity 0.4s var(--ease);
  }

  .packet {
    visibility: hidden;
    fill: var(--signal);
    filter: drop-shadow(0 0 6px rgba(124, 240, 197, 0.9));
  }

  .packet.is-on {
    visibility: visible;
  }

  .hub {
    fill: var(--panel);
    stroke: var(--signal);
    stroke-width: 1.2;
  }

  .hub-inner {
    fill: none;
    stroke: rgba(124, 240, 197, 0.4);
    stroke-dasharray: 3 5;
    transform-origin: 300px 300px;
  }

  .hub-label {
    fill: var(--text);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    text-anchor: middle;
    letter-spacing: -0.02em;
  }

  .hub-sub {
    fill: var(--signal);
    font-family: var(--font-mono);
    font-size: 11px;
    text-anchor: middle;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .node-box {
    fill: var(--bg-2);
    stroke: var(--line-2);
    stroke-width: 1.2;
    transition:
      stroke 0.35s var(--ease),
      fill 0.35s var(--ease);
  }

  .node-n {
    fill: var(--text);
    font-family: var(--font-mono);
    font-size: 18px;
    text-anchor: middle;
  }

  .node-k {
    fill: var(--muted);
    font-family: var(--font-mono);
    font-size: 9px;
    text-anchor: middle;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .node {
    transition: transform 0.4s var(--ease);
  }

  .node.is-active .node-box {
    stroke: var(--signal);
    fill: #0f1d19;
  }

  .node.is-active .node-n {
    fill: var(--signal);
  }

  .diagram.has-active .edge-flow {
    opacity: 0.12;
  }

  .diagram.has-active .edge-flow.is-active {
    opacity: 1;
  }

  .edge.is-active {
    stroke: rgba(124, 240, 197, 0.55);
  }

  .diagram-cap {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 10px;
    color: var(--dim);
  }

  [data-active-label] {
    color: var(--signal);
  }

  .domains {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .domain {
    position: relative;
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--line);
    outline: none;
    cursor: default;
  }

  .domain::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 1px;
    width: 100%;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }

  .domain.is-active::before {
    transform: scaleX(1);
  }

  .domain:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 6px;
  }

  .domain-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .domain-n {
    color: var(--signal);
  }

  .domain-id {
    font-size: 10px;
    text-transform: none;
    color: var(--dim);
    letter-spacing: 0.04em;
  }

  .domain-title {
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    letter-spacing: -0.025em;
    transition: color 0.3s var(--ease);
  }

  .domain-body {
    margin-top: 12px;
    color: var(--muted);
    max-width: 52ch;
  }
</style>
