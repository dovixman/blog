---
import { education } from '../data/profile';
---

<section class="section edu" id="formacion" aria-labelledby="formacion-title">
  <div class="wrap">
    <header class="section-head">
      <p class="section-index mono" data-reveal>03 · Formación</p>
      <div>
        <h2 class="section-title" id="formacion-title" data-split>Módulos <span class="muted">instalados.</span></h2>
        <p class="section-lede" data-reveal>
          La base académica sobre la que corre todo lo demás: ingeniería, seguridad e inteligencia artificial.
        </p>
      </div>
    </header>

    <ol class="modules">
      {
        education.map((m, i) => (
          <li class="module" data-module>
            <div class="module-top mono" aria-hidden="true">
              <span>{m.id}</span>
              <span class="module-slot">slot {String(i).padStart(2, '0')}</span>
            </div>
            <svg class="module-glyph" viewBox="0 0 120 40" aria-hidden="true">
              <path d="M0 20 H30 L40 8 H80 L90 32 H120" class="glyph-path" data-draw />
              <circle cx="40" cy="8" r="2.5" class="glyph-dot" />
              <circle cx="90" cy="32" r="2.5" class="glyph-dot" />
            </svg>
            <h3 class="module-title">{m.title}</h3>
            {m.detail && <p class="module-detail">{m.detail}</p>}
            <p class="module-time mono">
              <time datetime={String(m.from)}>{m.from}</time>
              {m.to ? (
                <>
                  <span aria-hidden="true"> — </span>
                  <span class="visually-hidden"> a </span>
                  <time datetime={String(m.to)}>{m.to}</time>
                </>
              ) : (
                <span> — </span>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .modules {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .modules {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  .module {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 26px 24px 24px;
    min-height: 300px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(14, 19, 25, 0.9), rgba(9, 12, 16, 0.6));
    overflow: hidden;
    transition:
      border-color 0.4s var(--ease),
      transform 0.5s var(--ease);
  }

  .module::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 0%), rgba(124, 240, 197, 0.09), transparent 45%);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    pointer-events: none;
  }

  .module:hover {
    border-color: var(--line-2);
  }

  .module:hover::before {
    opacity: 1;
  }

  .module-top {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--signal);
    text-transform: none;
  }

  .module-slot {
    color: var(--dim);
  }

  .module-glyph {
    width: 120px;
    height: 40px;
    margin: 6px 0 10px;
  }

  .glyph-path {
    fill: none;
    stroke: rgba(124, 240, 197, 0.6);
    stroke-width: 1.2;
  }

  .glyph-dot {
    fill: var(--bg);
    stroke: var(--signal);
    stroke-width: 1.2;
  }

  .module-title {
    font-size: clamp(1.4rem, 2vw, 1.7rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    max-width: 18ch;
  }

  .module-detail {
    color: var(--muted);
    font-size: 15px;
    max-width: 34ch;
  }

  .module-time {
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
  }
</style>
