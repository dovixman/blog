---
import { profile } from '../data/profile';
---

<section class="section contact" id="contacto" aria-labelledby="contacto-title">
  <canvas class="contact-scope" data-scope aria-hidden="true"></canvas>
  <div class="wrap contact-inner">
    <p class="section-index mono" data-reveal>04 · Canal abierto</p>
    <h2 class="contact-title" id="contacto-title" data-split>
      Hablemos de <span class="muted">sistemas.</span>
    </h2>
    <p class="contact-lede" data-reveal>
      Arquitectura, equipos, seguridad o cualquier experimento que merezca una conversación. El canal más
      directo es el correo.
    </p>

    <div class="terminal" data-reveal>
      <div class="terminal-bar mono" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <span>canal · mailto</span>
      </div>
      <div class="terminal-body">
        <span class="prompt mono" aria-hidden="true">$ mail</span>
        <a class="email" href={`mailto:${profile.email}`} data-email>
          <span data-scramble-email>{profile.email}</span><span class="caret" aria-hidden="true"></span>
        </a>
        <button class="copy mono" type="button" data-copy={profile.email}>
          <span data-copy-label>Copiar</span>
        </button>
        <span class="visually-hidden" aria-live="polite" data-copy-status></span>
      </div>
    </div>

    <ul class="links">
      <li>
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>
          Escribir correo <span class="arrow" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a class="btn btn--ext" href={profile.github} rel="me noopener" target="_blank">
          github.com/dovixman <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (se abre en una pestaña nueva)</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact {
    overflow: hidden;
    isolation: isolate;
    padding-bottom: clamp(110px, 14vw, 200px);
  }

  .contact-scope {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    opacity: 0.9;
  }

  .contact-inner {
    position: relative;
  }

  .contact-title {
    margin-top: 28px;
    font-size: clamp(2.6rem, 9vw, 8rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .contact-lede {
    margin-top: 28px;
    max-width: 52ch;
    color: var(--muted);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
  }

  .terminal {
    margin-top: clamp(40px, 6vw, 64px);
    max-width: 760px;
    border: 1px solid var(--line-2);
    border-radius: 16px;
    background: rgba(9, 12, 16, 0.82);
    backdrop-filter: blur(8px);
    overflow: hidden;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 10px;
    color: var(--dim);
  }

  .dots {
    display: inline-flex;
    gap: 6px;
  }

  .dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-2);
  }

  .dots i:first-child {
    background: var(--signal);
  }

  .terminal-body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    padding: 22px 20px;
  }

  .prompt {
    color: var(--signal);
    font-size: 13px;
    text-transform: none;
  }

  .email {
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 3.4vw, 1.9rem);
    text-decoration: none;
    color: var(--text);
    letter-spacing: -0.01em;
    background-image: linear-gradient(var(--signal), var(--signal));
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.5s var(--ease);
    overflow-wrap: anywhere;
  }

  .email:hover {
    background-size: 100% 1px;
  }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 4px;
    vertical-align: -0.12em;
    background: var(--signal);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .copy {
    margin-left: auto;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: transparent;
    color: var(--muted);
    font-size: 11px;
    cursor: pointer;
    transition:
      color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      background-color 0.25s var(--ease);
  }

  .copy:hover {
    color: var(--text);
    border-color: var(--signal);
  }

  .copy.is-done {
    color: var(--signal-ink);
    background: var(--signal);
    border-color: var(--signal);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
