---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap foot">
    <p class="mono">© {year} {profile.name} · dovixman.io</p>
    <p class="mono foot-status"><span class="pulse" aria-hidden="true"></span> señal estable · fin de la transmisión</p>
    <a class="mono foot-top" href="#top">Volver arriba ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 28px 0 36px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    align-items: center;
    justify-content: space-between;
    color: var(--dim);
  }

  .foot p,
  .foot a {
    font-size: 11px;
  }

  .foot-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .foot-top {
    text-decoration: none;
    color: var(--muted);
  }

  .foot-top:hover {
    color: var(--signal);
  }
</style>
