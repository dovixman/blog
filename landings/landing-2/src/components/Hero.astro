---
import { profile, experience, organizations, domains, education, START_YEAR } from '../data/profile';
const years = new Date().getFullYear() - START_YEAR;
const readouts = [
  { k: 'En producción desde', v: String(START_YEAR), live: false },
  { k: 'Años de trayectoria', v: String(years), live: true },
  { k: 'Roles', v: String(experience.length).padStart(2, '0'), live: false },
  { k: 'Organizaciones', v: String(organizations.length).padStart(2, '0'), live: false },
  { k: 'Dominios', v: String(domains.length).padStart(2, '0'), live: false },
  { k: 'Titulaciones', v: String(education.length).padStart(2, '0'), live: false },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <canvas class="topology" data-topology aria-hidden="true"></canvas>
  <div class="hero-vignette" aria-hidden="true"></div>
  <div class="hero-readout mono" aria-hidden="true" data-pointer-readout>
    <span>x <b data-px>0000</b></span>
    <span>y <b data-py>0000</b></span>
    <span class="hr-node">nodo <b data-pn>—</b></span>
  </div>

  <div class="wrap hero-inner">
    <p class="eyebrow mono" data-hero-in>
      <span class="pulse"></span>
      <span>{profile.name} · {profile.handle}</span>
      <span class="sep" aria-hidden="true">/</span>
      <span class="eyebrow-role">{profile.role} en {profile.company}</span>
    </p>

    <h1 class="hero-title" id="hero-title" data-hero-title>
      <span class="line">Diseño sistemas.</span>
      <span class="line muted">Lidero a los equipos</span>
      <span class="line muted">que los construyen.</span>
    </h1>

    <div class="hero-foot">
      <p class="hero-lede" data-hero-in>
        Soy David Fuentes. Más de una década entre arquitectura de software, DevOps, I+D y liderazgo técnico.
        Hoy, Lead Technical Architect en Intelygenz, en el proyecto MetTel.
      </p>
      <div class="hero-cta" data-hero-in>
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>
          Abrir canal <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ext" href={profile.github} rel="me noopener" target="_blank">
          GitHub <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> (se abre en una pestaña nueva)</span>
        </a>
      </div>
    </div>
  </div>

  <div class="wrap telemetry-wrap">
    <dl class="telemetry" data-telemetry>
      {
        readouts.map((r) => (
          <div class="tm">
            <dt class="mono">{r.k}</dt>
            <dd data-count={r.v}>{r.v}</dd>
          </div>
        ))
      }
    </dl>
    <p class="telemetry-note mono">Valores derivados del propio perfil</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 112px;
    overflow: hidden;
    isolation: isolate;
  }

  .topology {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    display: block;
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(120% 80% at 0% 100%, var(--bg) 20%, transparent 70%),
      linear-gradient(to bottom, rgba(7, 9, 12, 0.6), transparent 30%, transparent 70%, var(--bg));
  }

  @media (min-width: 900px) {
    .hero-vignette {
      background:
        linear-gradient(to right, rgba(7, 9, 12, 0.92) 0%, rgba(7, 9, 12, 0.7) 38%, transparent 68%),
        radial-gradient(120% 80% at 0% 100%, var(--bg) 20%, transparent 70%),
        linear-gradient(to bottom, rgba(7, 9, 12, 0.6), transparent 30%, transparent 70%, var(--bg));
    }
  }

  .hero-readout {
    position: absolute;
    top: 96px;
    right: var(--gutter);
    display: none;
    gap: 18px;
    font-size: 10px;
    color: var(--dim);
  }

  .hero-readout b {
    font-weight: 500;
    color: var(--muted);
  }

  @media (min-width: 900px) and (hover: hover) {
    .hero-readout {
      display: flex;
    }
  }

  .hero-inner {
    position: relative;
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    color: var(--muted);
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .eyebrow .sep {
    color: var(--dim);
  }

  .hero-title {
    font-size: clamp(2.6rem, 7.3vw, 7.4rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 500;
  }

  .hero-title .line {
    display: block;
  }

  @media (max-width: 700px) {
    .hero-title {
      font-size: clamp(2.3rem, 11vw, 3.4rem);
    }
    .hero-title .line + .line {
      display: inline;
    }
    .topology {
      opacity: 0.55;
    }
  }

  .hero-foot {
    margin-top: clamp(36px, 5vw, 60px);
    display: grid;
    gap: 28px;
    align-items: end;
  }

  @media (min-width: 900px) {
    .hero-foot {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 60px;
    }
  }

  .hero-lede {
    max-width: 52ch;
    color: var(--muted);
    font-size: clamp(1.02rem, 1.35vw, 1.2rem);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .telemetry-wrap {
    margin-top: clamp(48px, 6vw, 72px);
    padding-bottom: 28px;
  }

  .telemetry {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line-2);
  }

  @media (min-width: 700px) {
    .telemetry {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .telemetry {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .tm {
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 1100px) {
    .tm {
      border-bottom: 0;
    }
    .tm + .tm {
      padding-left: 16px;
      border-left: 1px solid var(--line);
    }
  }

  .tm dt {
    font-size: 10px;
    color: var(--dim);
  }

  .tm dd {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .telemetry-note {
    margin-top: 14px;
    font-size: 10px;
    color: var(--dim);
  }

  .telemetry-note::before {
    content: '* ';
    color: var(--amber);
  }
</style>
